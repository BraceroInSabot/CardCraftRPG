# Copy to .env next to docker-compose.yml to override the defaults.
APP_PORT=8080
DJANGO_SECRET_KEY=change-me-in-production
# Add your server's host name or LAN IP if you open the app from another device.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080
POSTGRES_DB=cardcraft
POSTGRES_USER=cardcraft
POSTGRES_PASSWORD=cardcraft
POSTGRES_PORT=5432
# true = load the demo RPG system on start-up (only once; it skips if already present)
SEED_DEMO=false
# Add the address you open the app from if it is not localhost:8080 (needed for logins / CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# First Master account, created on start-up if it does not exist yet (there is no self sign-up).
MASTER_USERNAME=
MASTER_PASSWORD=
MASTER_EMAIL=
# true = create the default development Master bracero / bracero123 (never on a public server)
SEED_MASTER=false
