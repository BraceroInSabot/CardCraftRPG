# Export these (or set them in your shell / IDE run config) before running Django.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Set both to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
LOGIN_THROTTLE_RATE=5/min

POSTGRES_DB=cardcraft
POSTGRES_USER=cardcraft
POSTGRES_PASSWORD=cardcraft
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
